{
  "name": "mall-of-westeros",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Premium phones and laptops e-commerce for Westeros",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:next\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:next": "next dev --turbopack -p 3001",
    "build": "next build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "concurrently \"NODE_ENV=production node dist/server/index.js\" \"next start -p 3001\"",
    "lint": "next lint",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.1",
    "@neondatabase/serverless": "^1.0.2",
    "@stripe/stripe-js": "^2.4.0",
    "@tanstack/react-query": "^5.17.19",
    "bcrypt": "^5.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.45.1",
    "fastify": "^4.25.2",
    "lucide-react": "^0.525.0",
    "next": "15.3.5",
    "nodemailer": "^6.9.8",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-hot-toast": "^2.5.2",
    "stripe": "^14.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
